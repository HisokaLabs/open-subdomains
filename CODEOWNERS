# Everyone can propose a subdomain; only maintainers merge one.
* @dikaardnt @daningl

# The zone itself. Keep this tight.
/dnsconfig.js          @dikaardnt
/domains/_meta.json    @dikaardnt
/domains/SCHEMA.json   @dikaardnt
